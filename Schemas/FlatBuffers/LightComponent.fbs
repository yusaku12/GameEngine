include "Common.fbs";
namespace Engine.Serialization;
table LightComponentPayload {
    kind:ubyte;
    color:Vec3;
    intensity:float = 1;
    range:float = 10;
    inner_angle:float = 25;
    outer_angle:float = 40;
    casts_shadow:bool = false;
    shadow_distance:float = 50;
    shadow_bias:float = 0.001;
    normal_bias:float = 0.02;
    atmosphere_sun_light:bool = false;
    atmosphere_sun_index:ubyte = 0;
    volumetric_scattering_intensity:float = 1;
    light_shaft_bloom_enabled:bool = false;
    light_shaft_bloom_scale:float = 1;
    light_shaft_bloom_threshold:float = 1;
    light_shaft_bloom_tint:Vec3;
    light_shaft_occlusion_enabled:bool = false;
    light_shaft_occlusion_mask_darkness:float = 0.5;
}
root_type LightComponentPayload;
file_identifier "LGHT";
