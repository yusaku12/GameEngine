include "Common.fbs";
include "AnimationClip.fbs";

namespace Engine.Serialization;

// Legacy Controller types/slots are reserved for reading v1/v2 payloads.
enum AnimatorParameterValueType:ubyte { Float, Int, Bool, Trigger }

table AnimatorParameterValueData {
    id:uint;
    type:AnimatorParameterValueType;
    float_value:float;
    int_value:int;
    bool_value:bool;
}

table AnimatorClipReference {
    guid:AssetGuid;
    path:string;
}

table AnimatorClipConfiguration {
    guid:AssetGuid;
    path:string;
    name:string;
    speed:float = 1.0;
    apply_root_motion:bool;
    wrap_mode:AnimationWrapMode = null;
}

table AnimatorComponentPayload {
    skeleton_guid:AssetGuid;
    clip_guid:AssetGuid;
    legacy_controller_guid:AssetGuid;
    speed:float = 1.0;
    apply_root_motion:bool;
    playing:bool = true;
    current_state:uint (deprecated);
    normalized_time:float;
    parameters:[AnimatorParameterValueData] (deprecated);
    skeleton_path:string;
    clip_path:string;
    controller_path:string (deprecated);
    controller_clips:[AnimatorClipReference] (deprecated);
    root_motion_joint:string;
    clips:[AnimatorClipConfiguration];
    initial_clip_guid:AssetGuid;
    auto_play:bool = true;
}

root_type AnimatorComponentPayload;
file_identifier "ACMP";
