include "TerrainMaterial.fbs";

namespace Engine.Serialization;

table TerrainNoiseSettings {
    mode:ubyte = 1;
    seed:uint = 0;
    width:uint = 65;
    height:uint = 65;
    frequency:float = 4;
    offset_x:float = 0;
    offset_z:float = 0;
    octaves:uint = 6;
    persistence:float = 0.5;
    lacunarity:float = 2;
}

table TerrainLodSettings {
    enabled:bool = false;
    max_level:uint = 4;
    distance:float = 50;
}

table TerrainErosionSettings {
    seed:uint = 0;
    droplets:uint = 5000;
    max_lifetime:uint = 64;
    radius:uint = 3;
    inertia:float = 0.05;
    capacity:float = 4;
    min_slope:float = 0.001;
    deposit_rate:float = 0.3;
    erosion_rate:float = 0.3;
    evaporation:float = 0.01;
    gravity:float = 4;
    initial_water:float = 1;
    initial_speed:float = 1;
}

table TerrainComponentPayload {
    width:uint = 2;
    height:uint = 2;
    samples:[float] (required);
    size_x:float = 100;
    size_z:float = 100;
    height_scale:float = 20;
    height_offset:float = 0;
    uv_repeat_x:float = 1;
    uv_repeat_z:float = 1;
    cast_shadows:bool = true;
    noise_settings:TerrainNoiseSettings;
    material_settings:TerrainMaterialData;
    chunk_cells:uint = 64;
    lod_settings:TerrainLodSettings;
    erosion_settings:TerrainErosionSettings;
}

root_type TerrainComponentPayload;
file_identifier "TRRN";
